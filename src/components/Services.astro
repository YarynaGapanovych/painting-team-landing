---
const services = [
  {
    tone: "malowanie",
    title: ["Kompleksowe Malowanie"],
    description: ["Gruntowanie 1 Warstwa, Malowanie 2 Warstwy"],
    price: "32",
    image: "/images/service-malowanie.jpg",
    alt: "Wałek malarski w dłoni",
  },
  {
    tone: "szpachlowanie",
    title: ["Szpachlowanie–Szlifowanie"],
    description: ["Standardowe Wyrównywanie Ubytków Bez Lampy"],
    price: "40",
    image: "/images/service-szpachlowanie.jpg",
    alt: "Szpachlowanie ściany",
  },
  {
    tone: "gladzi",
    title: ["Wykonanie Gładzi VIP"],
    description: ["Perfekcyjne Wykończenie I Szlifowanie Z Lampą LED"],
    price: "50",
    image: "/images/service-gladzi.jpg",
    alt: "Szlifowanie gładzi tarczą",
  },
];
---

<section class="services" aria-label="Cennik usług">
  <ul class="grid">
    {
      services.map((service) => (
        <li class={`card ${service.tone}`}>
          <div class="photo">
            <img src={service.image} alt={service.alt} />
          </div>
          <div class="body">
            <h2 class="title">
              {service.title.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))}
            </h2>
            <p class="desc">
              {service.description.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
            <p class="price">
              {service.price} PLN / M<sup>2</sup>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    margin-top: 1.15rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    background: transparent;
    min-height: 100%;
  }

  .malowanie {
    --wall: #f2f0ec;
  }

  .szpachlowanie {
    --wall: #f0eeea;
  }

  .gladzi {
    --wall: #f2f0ec;
  }

  .photo {
    background: var(--photo);
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    /* padding: 0.7rem 0.45rem 0.8rem; */
    padding: 20px 0;
    text-align: center;
    color: #1c1916;
    background-color: var(--wall, #f2f0ec);
  }

  .title {
    margin: 0;
    /* font-size: clamp(1.15rem, 1.7vw, 1.45rem); */
    font-weight: 700;
    line-height: 1.2;
  }

  .desc {
    /* margin: 0.4rem 0 0; */
    color: #3a3530;
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .price {
    /* margin: auto 0 0; */
    /* padding-top: 0.7rem; */
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .price sup {
    /* font-size: 0.65em; */
    line-height: 0;
  }

  @media (max-width: 56.25rem) {
    .grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
      margin-inline: auto;
    }
  }
</style>
