---
---

<section class="hero" aria-label="Baner">
  <div class="logo-wrap">
    <img
      class="logo"
      src="/images/logo.png"
      width="783"
      height="691"
      alt=""
      data-fallback="/images/logo.svg"
    />
  </div>
  <p class="tagline">
    <span>Brudna</span>
    <span>robota,</span>
    <span>przejrzysty</span>
    <span>cennik.</span>
  </p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .logo-wrap {
    position: relative;
    isolation: isolate;
    width: min(100%, 36rem);
    margin: 0.25rem 0 0.35rem;
  }

  .logo-wrap::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -6% -8% -2%;
    background: radial-gradient(
      ellipse at 50% 52%,
      rgb(255 240 210 / 0.85) 0%,
      rgb(255 214 150 / 0.5) 28%,
      rgb(255 186 90 / 0.22) 50%,
      transparent 72%
    );
    filter: blur(36px);
    pointer-events: none;
  }

  .logo-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: radial-gradient(
      ellipse at 48% 50%,
      rgb(255 230 180 / 0.35) 0%,
      rgb(255 200 120 / 0.14) 42%,
      transparent 68%
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .logo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    margin: 0;
    filter:
      drop-shadow(0 0 18px rgb(255 236 200 / 0.7))
      drop-shadow(0 0 48px rgb(255 210 140 / 0.45));
  }

  .tagline {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0 1.15rem;
    padding: 0.35rem 0.5rem 1.25rem;
    font-family: var(--font-stencil);
    font-size: clamp(1.25rem, 3.2vw, 2.65rem);
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
  }

  @media (min-width: 48.01rem) {
    .hero {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      gap: 1.5rem 3.5rem;
      padding: 0.5rem 0 1.5rem;
    }

    .logo-wrap {
      width: min(48%, 38rem);
      flex: 0 1 38rem;
      margin: 0;
    }

    .tagline {
      flex: 0 1 auto;
      align-items: flex-start;
      margin: 0;
      padding: 0;
      font-size: clamp(2.4rem, 4.6vw, 4rem);
      text-align: left;
    }
  }

  @media (max-width: 48rem) {
    .logo-wrap {
      width: min(100%, 22rem);
    }
  }
</style>
