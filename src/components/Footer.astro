---
const phoneDisplay = "+48 791 567 011";
const phoneHref = "tel:+48791567011";
const year = 2026;
---

<footer class="site-footer">
  <div class="meta">
    <p class="place">
      <svg
        class="icon"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"
        ></path>
      </svg>
      Kraków
    </p>
    <a class="phone" href={phoneHref}>
      <svg
        class="icon"
        viewBox="0 0 24 24"
        width="14"
        height="14"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
        ></path>
      </svg>
      {phoneDisplay}
    </a>
  </div>
  <p class="copy">© {year} Zorganizowana Grupa Malarska</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-end;
    gap: 0.45rem 1.25rem;
    width: 100%;
    margin-top: 0;
    background: transparent;
    border-top: 1px solid rgb(255 255 255 / 0.35);
    padding: clamp(2rem, 5vw, 3.5rem) 1rem 1.25rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
    gap: 0.2rem;
    width: max-content;
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .place,
  .phone {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }

  .icon {
    width: 1em;
    height: 1em;
    overflow: hidden;
    flex-shrink: 0;
  }

  .phone {
    text-decoration: none;
  }

  .phone:hover {
    text-decoration: underline;
  }

  .copy {
    flex-shrink: 0;
    margin: 0 0 0 auto;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-align: right;
  }

  @media (max-width: 48rem) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .meta {
      flex-direction: row;
      gap: 0.85rem;
    }

    .copy {
      margin-left: 0;
      text-align: left;
    }
  }
</style>
