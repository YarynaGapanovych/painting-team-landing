---
const phoneDisplay = "+48 791 567 011";
const phoneHref = "tel:+48791567011";
const year = 2026;
---

<footer class="site-footer">
  <div class="meta">
    <p class="place">
      <svg
        class="pin"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"
        ></path>
      </svg>
      Kraków
    </p>
    <a class="phone" href={phoneHref}>{phoneDisplay}</a>
  </div>
  <p class="copy">© {year} Zorganizowana Grupa Malarska</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: 0.45rem 1.25rem;
    width: 100%;
    margin-top: 1.15rem;
    background: transparent;
    border-top: 1px solid rgb(255 255 255 / 0.35);
    padding: 1.35rem 1rem 1.25rem;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.75rem;
    width: max-content;
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .place {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }

  .pin {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .phone {
    text-decoration: none;
  }

  .phone:hover {
    text-decoration: underline;
  }

  .copy {
    flex-shrink: 0;
    margin: 0 0 0 auto;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-align: right;
  }
</style>
